# rojoserve shared npm libraries, supporting services and local tools.
#
# The npm commands below are defined here rather than globally, so they apply to
# this file and to 90-rojoserve-lambda, but not to the Terraform repos above.

[DEFAULT]

# Refresh the lockfile, then prove a clean install works from it.
npmci =
	is_npm || na "npmci (no package.json)"
	npm install
	rm -rf node_modules
	npm ci

# Extra args are forwarded, e.g. mr audit --json
audit =
	is_npm || na "audit (no package.json)"
	npm run audit -- "$@"

