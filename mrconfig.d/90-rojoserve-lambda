# rojoserve Lambda function repos - the deployed modo-ps-cs-* functions plus the
# authorizer. Inherits the npm commands from 70-rojoserve-npm.
#
# Loaded last, so the mojo-lambda-admin release workflow below applies only to
# these repos.

[DEFAULT]

# Which version of the admin library is this function pinned to?
rojoadmin = npm ls @rojoserve-private-npm/mojo-lambda-admin

# Bump to the latest admin library without releasing.
adminlatest =
	npm install @rojoserve-private-npm/mojo-lambda-admin@latest
	npm clean-install

# Bump the admin library, patch-version, commit, push and cut a GitHub release.
#
# The two pre-flight checks are not optional: this stages with `git add -A`, so
# without them an unrelated dirty file would be swept into the release commit, or
# the release would be cut from a feature branch.
adminrelease =
	git diff --quiet && git diff --cached --quiet ||
		error "$MR_REPO: working tree is dirty; commit or stash before releasing"
	b=$(default_branch)
	cur=$(git rev-parse --abbrev-ref HEAD)
	test "$cur" = "$b" || error "$MR_REPO: releases are cut from $b, not $cur"
	npm install @rojoserve-private-npm/mojo-lambda-admin@latest
	npm --no-git-tag-version version patch
	npm install
	git add -A
	git commit -m 'chore: update mojo-lambda-admin to latest'
	git push
	gh release create "v$(jq -r .version package.json)" --generate-notes

